    "express": "^4.21.0",
    "cors": "^2.8.5",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.66.0",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.20.0",
    "@sentry/node": "^8.42.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.7.4",
