{
  "name": "navigator-zhizni-phone",
  "version": "1.34.0",
  "private": true,
  "description": "Ego: приложение на телефон (данные хранятся на устройстве)",
  "scripts": {
    "parse-schema": "node tools/parse-schema.mjs",
    "build": "node tools/parse-schema.mjs && node build.mjs",
    "android-prepare": "node tools/android-prepare.cjs",
    "test:ui": "node tests/run-all.mjs",
    "test:unit": "vitest run",
    "test": "npm run check && npm run test:tz && npm run test:ui",
    "check": "node tools/check-names.mjs",
    "test:tz": "node ../scripts/test-tz.mjs mobile"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scheduler": "0.27.0",
    "zod": "3.25.76",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@aparajita/capacitor-biometric-auth": "^9.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "@capacitor/cli": "^7.0.0",
    "vitest": "^2.1.1",
    "typescript": "^5.6.2",
    "playwright": "^1.49.0"
  }
}
