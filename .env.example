# --- Database ---
# ВАЖНО: значение ниже — для запуска backend ВНУТРИ docker-compose (весь стек через
# "docker compose up -d"), где контейнеры видят друг друга по именам сервисов ("db").
#
# Если запускаете backend НАПРЯМУЮ на своей машине (не в Docker) для разработки, а
# Postgres поднят через "docker compose up -d db" — замените "db" на "localhost"
# (порт 5432 проброшен наружу только на 127.0.0.1, см. docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_life_navigator?schema=public"
DATABASE_URL="postgresql://postgres:postgres@db:5432/ai_life_navigator?schema=public"

# --- Telegram ---
TELEGRAM_BOT_TOKEN="123456:your-bot-token-from-botfather"
# Ваш домен (тот же, что в Caddyfile) — именно его вы укажете в @BotFather как Web App URL.
TELEGRAM_WEBAPP_URL="https://your-domain.com"

# --- AI Provider ---
# Провайдер-агностичный слой: реализован Anthropic, легко добавить других
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL_CHEAP="claude-haiku-4-5-20251001"
AI_MODEL_STRONG="claude-sonnet-5"

# --- Трёхслойная AI-система: роутер/специалист (частые дешёвые вызовы) ---
# Оба опциональны. Без них всё работает через Anthropic на всех уровнях, как раньше —
# просто без экономии на частых вызовах. Verifier-слой (отчёты, "почему я остановился",
# портрет по дневнику) всегда на Anthropic независимо от этих ключей.
# Gemini: aistudio.google.com/apikey — бесплатный тариф.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
# Groq: console.groq.com/keys — бесплатный тариф, используется как фолбэк, если
# Gemini недоступен (лимит/сбой/не настроен).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Semantic Memory (раздел 37) ---
# Anthropic не предоставляет embeddings API — используется Voyage AI
# (её же рекомендует сама Anthropic: https://docs.claude.com/en/docs/build-with-claude/embeddings)
# Без ключа Semantic Memory работает в облегчённом режиме (поиск по словам).
VOYAGE_API_KEY=""
EMBEDDING_MODEL="voyage-3"

# --- Voice input (раздел 44, Версия 2) ---
# Anthropic не предоставляет audio-транскрипцию — используется OpenAI Whisper.
# Без ключа бот отвечает на голосовые сообщения просьбой написать текстом.
OPENAI_API_KEY=""

# --- Резервные копии в Google Drive (экран "Настройки") ---
# Получить: console.cloud.google.com → создать проект → APIs & Services → Credentials →
# Create Credentials → OAuth client ID → тип "Web application".
# В "Authorized redirect URIs" указать ровно то же, что ниже в GOOGLE_REDIRECT_URI.
# Без этих трёх переменных подключение Google Drive в приложении просто не предлагается.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/google/callback"

# --- Weather (для утреннего дайджеста) ---
# Ключ OpenWeatherMap: openweathermap.org/api → "Current Weather Data" (бесплатный
# тариф, 1000 вызовов/день). Если у пользователя указан город в профиле (экран "Я") —
# погода берётся для него, иначе используется WEATHER_DEFAULT_CITY ниже.
# Без ключа строка с погодой просто не появляется в дайджесте — остальное работает как обычно.
WEATHER_API_KEY=""
WEATHER_DEFAULT_CITY="Moscow"

# --- Мониторинг ошибок (Sentry) ---
# sentry.io → создать проект (платформа "Node.js") → скопировать DSN со страницы проекта.
# Бесплатный тариф. Без ключа ошибки по-прежнему видны только в логах контейнера
# ("docker compose logs backend") — с ключом вы получите пуш о первом же реальном креше.
SENTRY_DSN=""

# --- Server ---
PORT=4000
NODE_ENV="development"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Frontend (Vite, must be prefixed VITE_) ---
# Через Caddy backend доступен по /api — см. Caddyfile.
#
# ВАЖНО: это значение встраивается во фронтенд ВО ВРЕМЯ СБОРКИ образа (build-time
# ARG, см. frontend/Dockerfile), а не читается контейнером во время работы. Если вы
# поменяете это значение ПОСЛЕ того, как frontend уже был собран — "docker compose up
# -d" его не подхватит. Нужно пересобрать именно frontend:
#   docker compose up -d --build frontend
VITE_API_URL="https://your-domain.com/api"
VITE_TELEGRAM_BOT_USERNAME="your_bot_username"
